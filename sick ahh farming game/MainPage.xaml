<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="sick_ahh_farming_game.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#FFD447">

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0">

            <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
            <BoxView
                Color="#FFD447"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

            <Grid
                Padding="25"
                RowSpacing="18"
                ColumnSpacing="15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="Plot1"
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot2"
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot3"
                    Grid.Row="0"
                    Grid.Column="2"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot4"
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot5"
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot6"
                    Grid.Row="1"
                    Grid.Column="2"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot7"
                    Grid.Row="2"
                    Grid.Column="0"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot8"
                    Grid.Row="2"
                    Grid.Column="1"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot9"
                    Grid.Row="2"
                    Grid.Column="2"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot10"
                    Grid.Row="3"
                    Grid.Column="0"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot11"
                    Grid.Row="3"
                    Grid.Column="1"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

                <Button
                    x:Name="Plot12"
                    Grid.Row="3"
                    Grid.Column="2"
                    BackgroundColor="#B86C3C"
                    CornerRadius="25" />

            </Grid>

        </Grid>

        <Border
            Grid.Row="1"
            BackgroundColor="#F5F0E8"
            Stroke="#5C3B32"
            StrokeThickness="2"
            Padding="8">

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="0"
                    Text="🌱"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="FarmButton_Clicked" />

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="1"
                    Text="🌾"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="InventoryButton_Clicked" />

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="2"
                    Text="🎒"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="ShopButton_Clicked" />

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="3"
                    Text="🐱"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="AccountButton_Clicked" />

            </Grid>

        </Border>

    </Grid>

</ContentPage>