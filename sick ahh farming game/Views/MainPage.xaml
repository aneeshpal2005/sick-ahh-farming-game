<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="sick_ahh_farming_game.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#FFD447">

    <Grid RowDefinitions="Auto,*,Auto">

        <Image
            Grid.Row="0"
            Grid.RowSpan="3"
            Source="farm_background.png"
            Aspect="AspectFill"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand" />

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,15,20,5">
            <Label />
            <Border BackgroundColor="#F5E6B8" Stroke="#5C3B32" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="10,5">
                <Label
                    x:Name="CoinsLabel"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#5C3B32"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <Grid Padding="20" RowSpacing="12" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot1" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot1" Aspect="AspectFit" />
                    <Label x:Name="TextPlot1" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot1" AutomationId="Plot1" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="1" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot2" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot2" Aspect="AspectFit" />
                    <Label x:Name="TextPlot2" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot2" AutomationId="Plot2" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="2" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot3" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot3" Aspect="AspectFit" />
                    <Label x:Name="TextPlot3" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot3" AutomationId="Plot3" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot4" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot4" Aspect="AspectFit" />
                    <Label x:Name="TextPlot4" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot4" AutomationId="Plot4" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot5" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot5" Aspect="AspectFit" />
                    <Label x:Name="TextPlot5" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot5" AutomationId="Plot5" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="2" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot6" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot6" Aspect="AspectFit" />
                    <Label x:Name="TextPlot6" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot6" AutomationId="Plot6" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot7" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot7" Aspect="AspectFit" />
                    <Label x:Name="TextPlot7" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot7" AutomationId="Plot7" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="1" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot8" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot8" Aspect="AspectFit" />
                    <Label x:Name="TextPlot8" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot8" AutomationId="Plot8" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="2" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot9" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot9" Aspect="AspectFit" />
                    <Label x:Name="TextPlot9" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot9" AutomationId="Plot9" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="0" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot10" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot10" Aspect="AspectFit" />
                    <Label x:Name="TextPlot10" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot10" AutomationId="Plot10" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="1" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot11" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot11" Aspect="AspectFit" />
                    <Label x:Name="TextPlot11" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot11" AutomationId="Plot11" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="2" HeightRequest="85">
                    <Image Source="plot_empty.png" Aspect="AspectFill" />
                    <Image x:Name="CropPlot12" Aspect="AspectFit" />
                    <Image x:Name="OverlayPlot12" Aspect="AspectFit" />
                    <Label x:Name="TextPlot12" Text="" FontSize="18" TextColor="White" FontAttributes="Bold" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,6" InputTransparent="True" />
                    <Button x:Name="Plot12" AutomationId="Plot12" BackgroundColor="Transparent" Clicked="PlotButton_Clicked"/>
                </Grid>

            </Grid>
        </ScrollView>

        <Grid Grid.Row="2" HeightRequest="70" HorizontalOptions="FillAndExpand">

            <Image
                Source="ui_bar.png"
                Aspect="Fill"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand" />

            <Grid ColumnDefinitions="*,*,*,*" Padding="10">

                <Border Grid.Column="0" BackgroundColor="#E6D7C3" Stroke="#C2B29F" StrokeThickness="1" StrokeShape="RoundRectangle 12" Margin="2">
                    <ImageButton Source="icon_farm.png" HeightRequest="36" WidthRequest="36" Aspect="AspectFit" BackgroundColor="Transparent" Clicked="FarmButton_Clicked" />
                </Border>

                <ImageButton Grid.Column="1" Source="icon_inventory.png" HeightRequest="36" WidthRequest="36" Aspect="AspectFit" BackgroundColor="Transparent" Clicked="InventoryButton_Clicked" />

                <ImageButton Grid.Column="2" Source="icon_shop.png" HeightRequest="36" WidthRequest="36" Aspect="AspectFit" BackgroundColor="Transparent" Clicked="ShopButton_Clicked" />

                <ImageButton Grid.Column="3" Source="icon_account.png" HeightRequest="36" WidthRequest="36" Aspect="AspectFit" BackgroundColor="Transparent" Clicked="AccountButton_Clicked" />

            </Grid>
        </Grid>

    </Grid>
</ContentPage>