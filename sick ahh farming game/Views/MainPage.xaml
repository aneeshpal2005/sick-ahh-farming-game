<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="sick_ahh_farming_game.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#FFD447">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,10">
            <Label
                Text="My Farm"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#5C3B32"
                VerticalOptions="Center" />
            <Label
                x:Name="CoinsLabel"
                Grid.Column="1"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#5C3B32"
                VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="5" Padding="20,0">
            <Label
                Text="Tap a seed, then tap an empty plot to plant."
                FontSize="14"
                TextColor="#5C3B32"
                HorizontalOptions="Center" />
            <HorizontalStackLayout
                x:Name="SeedSelector"
                Spacing="10"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <Grid
                Padding="25"
                RowSpacing="18"
                ColumnSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="Plot1"
                        Grid.Row="0" 
                        Grid.Column="0" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot2"
                        Grid.Row="0" 
                        Grid.Column="1" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot3"
                        Grid.Row="0" 
                        Grid.Column="2" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot4"
                        Grid.Row="1" 
                        Grid.Column="0" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot5"
                        Grid.Row="1" 
                        Grid.Column="1" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot6"
                        Grid.Row="1" 
                        Grid.Column="2" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot7"
                        Grid.Row="2" 
                        Grid.Column="0" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot8"
                        Grid.Row="2" 
                        Grid.Column="1" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot9"
                        Grid.Row="2" 
                        Grid.Column="2" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot10"
                        Grid.Row="3" 
                        Grid.Column="0" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot11"
                        Grid.Row="3" 
                        Grid.Column="1" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
                
                <Button x:Name="Plot12" 
                        Grid.Row="3" 
                        Grid.Column="2" 
                        Text="" 
                        BackgroundColor="#B86C3C" 
                        CornerRadius="25" 
                        FontSize="24" />
            
            </Grid>
        </ScrollView>

        <Border
            Grid.Row="3"
            BackgroundColor="#F5F0E8"
            Stroke="#5C3B32"
            StrokeThickness="2"
            Padding="8">

            <Grid ColumnDefinitions="*,*,*,*">

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="0"
                    Text="🌱"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="FarmButton_Clicked" />

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="1"
                    Text="🌾"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="InventoryButton_Clicked" />

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="2"
                    Text="🎒"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="ShopButton_Clicked" />

                <!-- # REPLACE WITH IMAGE EMOJI PLACE HOLDER -->
                <Button
                    Grid.Column="3"
                    Text="🐱"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Clicked="AccountButton_Clicked" />

            </Grid>

        </Border>

    </Grid>

</ContentPage>