<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="sick_ahh_farming_game.InventoryPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#FFF4C7">

    <Grid RowDefinitions="Auto,*,Auto">

        <Label
            Grid.Row="0"
            Text="Seed Bag"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="#5C3B32"
            HorizontalOptions="Center"
            Margin="0,20,0,10" />

        <ScrollView Grid.Row="1">
            <CollectionView
                x:Name="InventoryCollectionView"
                SelectionMode="Single"
                SelectionChanged="InventoryCollectionView_SelectionChanged"
                Margin="20">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="15" HorizontalItemSpacing="15" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            HeightRequest="90"
                            BackgroundColor="#F5E6B8"
                            Stroke="#8C6B4A"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 15">
                            <Grid>
                                <Label
                                    Text="{Binding Seed.Emoji}"
                                    FontSize="40"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                                <Frame
                                    BackgroundColor="#8C6B4A"
                                    Padding="5,2"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    CornerRadius="8"
                                    Margin="5">
                                    <Label
                                        Text="{Binding DisplayQuantity}"
                                        TextColor="White"
                                        FontSize="11"
                                        FontAttributes="Bold" />
                                </Frame>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="#F5F0E8" Stroke="#5C3B32" StrokeThickness="2" Padding="8">
            <Grid ColumnDefinitions="*,*,*,*">
                <Button Grid.Column="0" Text="🌱" FontSize="28" BackgroundColor="Transparent" Clicked="FarmButton_Clicked" />

                <Border Grid.Column="1" BackgroundColor="#E6D7C3" Stroke="#C2B29F" StrokeThickness="1" StrokeShape="RoundRectangle 12" Margin="2">
                    <Button Text="🎒" FontSize="26" BackgroundColor="Transparent" Clicked="InventoryButton_Clicked" />
                </Border>

                <Button Grid.Column="2" Text="🌾" FontSize="28" BackgroundColor="Transparent" Clicked="ShopButton_Clicked" />
                <Button Grid.Column="3" Text="🐱" FontSize="28" BackgroundColor="Transparent" Clicked="AccountButton_Clicked" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>